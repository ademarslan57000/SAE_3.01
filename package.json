{
    "name": "parking-app",
    "version": "1.0.0",
    "description": "Application de gestion de parkings avec réservation",
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "jest": {
        "testEnvironment": "jsdom",
        "moduleFileExtensions": [
            "js"
        ],
        "testMatch": [
            "**/__tests__/**/*.test.js"
        ],
        "collectCoverageFrom": [
            "assets/js/**/*.js",
            "!assets/js/**/*.translation.js",
            "!assets/js/main.js"
        ],
        "coverageDirectory": "coverage",
        "transformIgnorePatterns": [
            "node_modules/(?!.*)"
        ]
    },
    "devDependencies": {
        "@babel/core": "^7.28.6",
        "@babel/preset-env": "^7.28.6",
        "babel-jest": "^30.2.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0"
    }
}
